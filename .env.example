# TTS Adapter Configuration
# Copy to .env and adjust as needed

# Engine selection
TTS_ENGINE=qwen3

# Model settings
TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_DEVICE=cuda:0
TTS_DTYPE=bfloat16

# Defaults
TTS_DEFAULT_SPEAKER=Ryan
TTS_DEFAULT_LANGUAGE=Russian

# Server
TTS_HOST=0.0.0.0
TTS_PORT=9880
