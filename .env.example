# TTS Adapter Configuration
# Copy to .env and adjust as needed

# Engine selection
TTS_ENGINE=qwen3

# Shared defaults (all engines), eg 'ono_anna', 'sohee', 'vivian', 'serena'
TTS_DEFAULT_SPEAKER=ono_anna
TTS_DEFAULT_LANGUAGE=Russian

# Server
TTS_HOST=0.0.0.0
TTS_PORT=9880

# --- Engine-specific settings ---

# Qwen3 engine (TTS_QWEN3_*)
TTS_QWEN3_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_QWEN3_DEVICE=cuda:0
TTS_QWEN3_DTYPE=bfloat16

# IndexTTS2 engine (remote-worker architecture - only used when TTS_ENGINE=indextts2)
# Main adapter just talks HTTP to the worker; worker runs in vendor/index-tts/.venv.
# Worker-side env (MODEL_DIR, USE_FP16, ...) is documented in docs/engines/indextts2/README.md.
# Start the worker with: make run-indextts2
# TTS_INDEXTTS2_URL=http://localhost:9881
# TTS_INDEXTTS2_TIMEOUT=180

# VoxCPM2 engine (remote-worker architecture - only used when TTS_ENGINE=voxcpm2)
# Main adapter just talks HTTP to the worker; worker runs in vendor/voxcpm/.venv.
# Worker-side env (MODEL_DIR, OPTIMIZE, LOAD_DENOISER, ...) is documented in
# docs/engines/voxcpm2/README.md. Start the worker with: make run-voxcpm2
# TTS_VOXCPM2_URL=http://localhost:9882
# TTS_VOXCPM2_TIMEOUT=180
# TTS_VOXCPM2_PORT=9882
# Worker-side: defaults are sane (LOAD_DENOISER=false avoids surprise ModelScope
# download; OPTIMIZE=true runs torch.compile at first /load - adds ~30s).
# Relative paths anchor at repo root regardless of process cwd, but absolute is safest.
# TTS_VOXCPM2_MODEL_DIR=./vendor/voxcpm/checkpoints/VoxCPM2
# TTS_VOXCPM2_OPTIMIZE=true
# TTS_VOXCPM2_LOAD_DENOISER=false

# --- Offline Mode ---
# Two paths to local-only Qwen3 inference:
#
# (A) Use HF cache (default - works if you already have the model in
#     ~/.cache/huggingface/hub/, common when other neuro projects on the
#     host already pulled it). Just leave TTS_QWEN3_MODEL_PATH UNSET and
#     the engine loads via TTS_QWEN3_MODEL_ID from HF cache. With
#     HF_HUB_OFFLINE=1, no network calls at startup.
#
# (B) Use repo-local snapshot (only set this AFTER `make install-qwen3`
#     creates the dir). Path must be ABSOLUTE inside the container if you
#     run via `make up`. Pick the path the download script prints.
#
# TTS_QWEN3_MODEL_PATH=./models/qwen3/Qwen3-TTS-12Hz-1.7B-CustomVoice   # local
# TTS_QWEN3_MODEL_PATH=/home/app/.cache/huggingface/hub/models--Qwen--Qwen3-TTS-12Hz-1.7B-CustomVoice/snapshots/<hash>  # docker

# Recommended: just enable offline mode, let the engine use the HF cache:
HF_HUB_OFFLINE=1
