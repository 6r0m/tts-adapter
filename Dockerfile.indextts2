# syntax=docker/dockerfile:1

# IndexTTS2 worker image - THIN bind-mount variant.
#
# We don't bake torch / transformers / deepspeed / indextts into this image.
# Instead, the host's `vendor/index-tts/` (built once via `make install-indextts2`)
# is bind-mounted at /work/vendor/index-tts/ by compose. That gives us:
#
#   - One single source of truth for the vendor venv (host)
#   - Image stays ~1 GB instead of ~12 GB (no duplicated torch/cuDNN/cuBLAS wheels)
#   - Build is ~1-2 minutes instead of 30-40 minutes
#   - `make install-indextts2` updates the host vendor; container picks it up on next start
#
# ABI/host coupling we accept (verified during install):
#   - Host glibc must match container glibc (Ubuntu 22.04 = glibc 2.35 in both)
#   - Host venv's python interpreter (`/usr/local/bin/python`) must exist in the
#     container at the same path - we install python3.10 + symlink below
#   - Torch wheels in the venv carry their own CUDA libs (nvidia-cudnn-cu12 etc),
#     so the system CUDA in this base image just needs to be compatible with
#     torch's bundled version (cu128 → CUDA 12.8 driver, available via WSL2/host)

ARG REGISTRY=docker.io
FROM ${REGISTRY}/nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04 AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPYCACHEPREFIX=/tmp/pycache

# Minimal system deps:
#   - python3.10: matches host python (3.10.12) so the bind-mounted venv works
#   - tini: clean PID 1 / signal handling
#   - curl: healthcheck
#   - sox / libsox-fmt-all: indextts uses sox-format audio I/O for some pipelines
#   - ca-certificates: outbound HTTPS to HuggingFace on first /load (w2v-bert)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3.10-distutils \
    python3.10-venv \
    tini \
    curl \
    ca-certificates \
    sox \
    libsox-fmt-all \
 && rm -rf /var/lib/apt/lists/* \
 && ln -sf /usr/bin/python3.10 /usr/local/bin/python \
 && ln -sf /usr/bin/python3.10 /usr/local/bin/python3

# Non-root user
ARG USER=app
ARG UID=10001
RUN useradd -m -u ${UID} -s /bin/bash ${USER} \
 && install -d -o ${UID} -g ${UID} \
       /work /work/vendor /work/models /work/scripts/indextts2 /work/tts_adapter \
       /home/${USER}/.cache/huggingface /home/${USER}/.cache/numba

# Worker script + the two cross-venv-safe helper modules from the main adapter.
# These are TINY (a few KB) - everything heavy lives in the bind-mounted venv.
COPY --chown=${UID}:${UID} scripts/indextts2/serve.py /work/scripts/indextts2/serve.py
COPY --chown=${UID}:${UID} tts_adapter/__init__.py /work/tts_adapter/__init__.py
COPY --chown=${UID}:${UID} tts_adapter/audio_utils.py /work/tts_adapter/audio_utils.py
COPY --chown=${UID}:${UID} tts_adapter/gpu_utils.py /work/tts_adapter/gpu_utils.py

ENV HF_HOME=/home/app/.cache/huggingface \
    NUMBA_CACHE_DIR=/home/app/.cache/numba \
    TTS_INDEXTTS2_MODEL_DIR=/work/models/indextts2/IndexTTS-2 \
    TTS_INDEXTTS2_PORT=9881

USER ${USER}
# WORKDIR must be /work/vendor/index-tts because upstream's infer_v2.py does
#   os.environ['HF_HUB_CACHE'] = './checkpoints/hf_cache'
# at module import time. That relative path needs to resolve to the vendor's
# bind-mounted hf_cache (which holds w2v-bert + MaskGCT + CAMPPlus + BigVGAN).
WORKDIR /work/vendor/index-tts
EXPOSE 9881

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -fsS http://127.0.0.1:9881/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
# Use the bind-mounted venv's python directly. If the venv isn't mounted (host
# forgot `make install-indextts2` first), this fails immediately at startup
# with a clear ENOENT - better than mysterious import errors later.
CMD ["/work/vendor/index-tts/.venv/bin/python", "/work/scripts/indextts2/serve.py"]
